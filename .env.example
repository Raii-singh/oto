# ─── OTO — Root Environment Variables (Docker Compose) ───────────────────────
# Copy this to .env and fill in your values

# OMDb API (primary content source) — get free key at https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=bec831df

# TMDB API (fallback) — get key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# JWT secret — change this in production!
JWT_SECRET=oto_super_secret_jwt_key_change_in_production

# Content API provider: "omdb" or "tmdb"
CONTENT_API_PROVIDER=omdb
