!.env.example
# Keep service .env files OUT (they contain API keys)
services/*/.env

# ── Logs ────────────────────────────────────────────────
*.log
logs/

# ── OS ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE ─────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# ── Docker volumes (local) ───────────────────────────────
postgres-data/
redis-data/

