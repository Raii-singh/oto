# ── Node / npm ──────────────────────────────────────────
node_modules/
npm-debug.log*
.npm

# ── Next.js ─────────────────────────────────────────────
frontend/.next/
frontend/out/

# ── Dist (compiled TypeScript) ──────────────────────────
services/*/dist/

# ── Environment variables ────────────────────────────────
.env
.env.local
.env.*.local
